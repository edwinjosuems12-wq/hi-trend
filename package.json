{
  "name": "hitrendy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "starter/web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run web:build",
    "web:dev": "npm run dev -w starter/web",
    "web:build": "npm run build -w starter/web",
    "web:typecheck": "npm run typecheck -w starter/web",
    "web:lint": "npm run lint -w starter/web",
    "web:test": "npm run test -w starter/web",
    "validate": "bash scripts/validate.sh",
    "validate:e2e": "bash scripts/validate-e2e.sh",
    "backend:dev": "cd starter/backend && python -m alembic upgrade head && python -m uvicorn app.main:app --reload --port 8001 --env-file .env",
    "backend:test": "PYTHONPATH=starter/backend python -m pytest starter/backend/tests",
    "beta:check": "python scripts/beta_readiness_check.py",
    "beta:load-smoke": "python scripts/load_smoke.py",
    "backup": "PYTHONPATH=starter/backend python scripts/backup.py",
    "restore:drill": "PYTHONPATH=starter/backend python scripts/restore_drill.py",
    "web:test:e2e": "npm run test:e2e -w starter/web",
    "web:test:e2e:beta": "npm run test:e2e -w starter/web -- tests/e2e/beta-readiness.spec.ts",
    "images:worker": "cd starter/backend && PYTHONPATH=. python -m app.images.worker --interval 3",
    "dev": "npx --yes concurrently \"npm run web:dev\" \"npm run backend:dev\" \"npm run images:worker\""
  }
}